# ── 依赖与构建产物 ──
node_modules/
dist/
*.log

# ── 隐私数据（绝不入库！）──
# server/data/ 内有 SQLite 数据库（聊天记录/信件/设置）和用户上传的图片语音
server/data/
web/dist/

# ── 本地临时文件 ──
.DS_Store
.idea/
.vscode/
*.local
验证截图/
shots/
*.png
!web/public/*.png
# 安卓工程源码资源（启动屏 splash + launcher 图标）必须入库，否则 CI 构建缺资源
!web/android/app/src/main/res/**/*.png

# ── 工具产生的本地目录 ──
.playwright-cli/
.cloudstudio/

# ── 环境变量 ──
.env
.env.local
.env.*.local

.playwright
.playwright/
.cloudstudio
eunoia-source.tar.gz

# wrangler 本地开发状态
workers/.wrangler/
.wrangler/

# 调试截图（本地验证用，不入库）
web/test-shots/

# ── Capacitor 安卓构建产物（源码 android/ 需入库，仅排除编译输出） ──
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/**/*.keystore
android/**/*.jks
